# Kalshi credentials template — copy to credentials/kalshi.env and fill in real values.
#
# 1. Create the credentials/ directory (it's in .gitignore):
#      mkdir credentials
# 2. Copy this file:
#      copy kalshi.env.example credentials\kalshi.env       (Windows)
#      cp   kalshi.env.example credentials/kalshi.env       (Bash)
# 3. Save your Kalshi RSA private key (PEM format) to:
#      credentials/kalshi_key.pem
# 4. Edit credentials/kalshi.env with your real API key UUID.
#
# NEVER commit credentials/ — it's gitignored. The actual env file
# contains live secrets that must never reach the repository.
#
# Get your API key + RSA key pair from: https://kalshi.com/account/profile

KALSHI_API_KEY=00000000-0000-0000-0000-000000000000
KALSHI_PRIVATE_KEY_PATH=C:\Trading\btc-bias-engine\credentials\kalshi_key.pem
EXECUTE_TRADES=true
KALSHI_DEMO=false
