# ============================================================================
# BTC Bias Engine — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in YOUR values.
#   cp .env.example .env
#
# The engine reads these at startup. Never commit .env to git.
# ============================================================================

# ── Kalshi API Credentials ──────────────────────────────────────────────────
# Get these from https://kalshi.com/account/api
#
# Your API key ID (UUID format)
KALSHI_API_KEY=your-api-key-uuid-here

# RSA private key — provide EITHER the PEM content OR a file path (not both).
#
# Option A: Inline PEM (replace literal newlines with \n)
# KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----
#
# Option B: Path to your .pem file (recommended)
KALSHI_PRIVATE_KEY_PATH=C:\Users\YourName\.kalshi\private_key.pem

# ── Mode ────────────────────────────────────────────────────────────────────
# true  = Kalshi demo/paper trading (no real money)
# false = LIVE trading with real funds
KALSHI_DEMO=true

# true  = Actually submit orders to Kalshi
# false = Signal-only mode (log signals but don't trade)
EXECUTE_TRADES=false

# ── Risk Management ────────────────────────────────────────────────────────
# Maximum dollar loss per day before the engine auto-halts.
# Start conservative. You can raise this as you gain confidence.
DAILY_LOSS_LIMIT=15
